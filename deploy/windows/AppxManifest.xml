<?xml version="1.0" encoding="utf-8"?>
<!-- VOC 的 MSIX 清单。{VERSION} 和 {PUBLISHER} 由 build-msix.ps1 填入。 -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  IgnorableNamespaces="uap rescap desktop desktop2">

  <Identity Name="VOC.VoiceChat" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>VOC</DisplayName>
    <PublisherDisplayName>VOC contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>加密语音开黑 · 屏幕共享 · P2P 直连</Description>
  </Properties>

  <Dependencies>
    <!-- 1903 起才有 Windows Graphics Capture（屏幕共享） -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application Id="VOC" Executable="VOC.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="VOC"
        Description="加密语音开黑 · 屏幕共享 · P2P 直连"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- 开机自启（默认关闭，在 VOC 设置里打开；任务管理器「启动应用」里也能管理） -->
        <desktop:Extension Category="windows.startupTask" Executable="VOC.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="VOCStartup" Enabled="false" DisplayName="VOC" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Extensions>
    <!-- P2P 直连需要接收别人发来的 UDP；安装时自动放行，免得第一次运行弹防火墙框 -->
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="VOC.exe">
        <desktop2:Rule Direction="in" IPProtocol="UDP" Profile="all" />
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="all" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
